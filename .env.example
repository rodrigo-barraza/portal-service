# ════════════════════════════════════════════════════════════════
#  API — Local Environment Overrides
# ════════════════════════════════════════════════════════════════
#  These values override secrets from Vault and vault/.env.
#  Only add variables you want to change for local development.
#
#  To use:  cp .env.example .env
#
#  Resolution order (first wins):
#    1. process.env (manual env vars)
#    2. This file (.env)
#    3. Vault service
#    4. Shared vault/.env fallback
# ════════════════════════════════════════════════════════════════

# ── Server ─────────────────────────────────────────────────────
# API_PORT="4001"

# ── Vault Connection ──────────────────────────────────────────
# VAULT_SERVICE_URL="http://<host>:5599"
# VAULT_SERVICE_TOKEN=""

# ── Self-referential URLs ─────────────────────────────────────
# PORTAL_URL="http://localhost:4000"
# PORTAL_API_URL="http://localhost:4001"

# ── Upstream Services ─────────────────────────────────────────
# PRISM_URL="http://localhost:7777"
# TOOLS_API_URL="http://localhost:5590"
# SESSIONS_URL="http://localhost:5557"
# PRISM_CLIENT_URL="http://localhost:3333"
# LIGHTS_URL="http://localhost:4444"

# ── MongoDB ───────────────────────────────────────────────────
# MONGO_URI="mongodb://user:password@localhost:27017/?directConnection=true&replicaSet=rs0&authSource=admin"
# API_MONGO_DB_NAME="portal"

# ── MinIO ─────────────────────────────────────────────────────
# MINIO_ENDPOINT="http://localhost:9000"
# MINIO_ACCESS_KEY=""
# MINIO_SECRET_KEY=""

# ── LM Studio ────────────────────────────────────────────────
# LM_STUDIO_URL="http://localhost:1234"
# LM_STUDIO_2_URL=""

# ── Google Analytics (GA4 Data API) ──────────────────────────
# Base64-encoded service account JSON key (create at GCP Console → IAM → Service Accounts)
# GOOGLE_ANALYTICS_CREDENTIALS=""
# JSON array of GA4 properties to track:
# GOOGLE_ANALYTICS_PROPERTIES='[{"id":"<propertyId>","label":"rod.dev","measurementId":"G-R61CVJFDVF"}]'
