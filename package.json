{
  "name": "portal-service",
  "version": "1.0.0",
  "description": "API — BFF aggregator for the developer portal",
  "type": "module",
  "main": "src/boot.ts",
  "scripts": {
    "start": "node src/boot.ts",
    "dev": "node --watch src/boot.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "deploy": "bash deploy.sh",
    "deploy:dry": "bash deploy.sh --dry-run"
  },
  "keywords": [
    "portal",
    "dashboard",
    "observability"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google-analytics/data": "^7.1.0",
    "@google-cloud/monitoring": "^6.1.0",
    "@rodrigo-barraza/utilities-library": "github:rodrigo-barraza/utilities-library",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "minio": "^8.0.7",
    "mongodb": "^7.6.0",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.8",
    "typescript": "next",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.8.0"
}
