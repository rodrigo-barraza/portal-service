{
  "name": "portal-service",
  "version": "1.0.0",
  "description": "API — BFF aggregator for the developer portal",
  "type": "module",
  "main": "src/boot.js",
  "scripts": {
    "start": "node src/boot.js",
    "dev": "nodemon --legacy-watch src/boot.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "bash deploy.sh",
    "deploy:dry": "bash deploy.sh --dry-run"
  },
  "keywords": [
    "portal",
    "dashboard",
    "observability"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google-analytics/data": "^5.2.2",
    "@rodrigo-barraza/utilities-library": "git+https://github.com/rodrigo-barraza/utilities-library.git",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "minio": "^8.0.7",
    "mongodb": "^7.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "vitest": "^4.1.5"
  }
}
