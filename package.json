{
  "name": "portal-service",
  "version": "1.0.0",
  "description": "API — BFF aggregator for the developer portal",
  "type": "module",
  "main": "dist/boot.js",
  "types": "src/index.ts",
  "scripts": {
    "start": "node dist/boot.js",
    "dev": "nodemon --legacy-watch --ext ts --exec \"node --import tsx src/boot.ts\"",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "deploy": "bash deploy.sh",
    "deploy:dry": "bash deploy.sh --dry-run"
  },
  "keywords": [
    "portal",
    "dashboard",
    "observability"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google-analytics/data": "^5.2.2",
    "@rodrigo-barraza/utilities-library": "git+https://github.com/rodrigo-barraza/utilities-library.git",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "minio": "^8.0.7",
    "mongodb": "^7.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.21",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "^4.1.5"
  }
}
